{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "plantory",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-04",
	"vars": {
		"AUTH_BASE_URL": "https://auth.takagi.dev"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": true
	},
	"triggers": {
		"crons": ["* * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "plantory",
			"database_id": "3cccf19f-8c8e-4633-9240-f0202644620a"
		}
	]
}
