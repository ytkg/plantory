{
  "name": "plantory",
  "version": "0.1.0",
  "private": true,
  "description": "Indoor plant monitoring and daily reports.",
  "scripts": {
    "dev": "wrangler dev",
    "predev": "npm run build:assets",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "build:chart": "cp ./node_modules/chart.js/dist/chart.umd.min.js ./public/chart.umd.min.js",
    "build:markdown": "cp ./node_modules/marked/lib/marked.umd.js ./public/marked.umd.js && cp ./node_modules/dompurify/dist/purify.min.js ./public/purify.min.js",
    "build:layout": "node ./scripts/build-layouts.mjs",
    "build:assets": "npm run build:layout && npm run build:css && npm run build:chart && npm run build:markdown",
    "build": "npm run build:assets && npm run check",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply plantory --local",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.58.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.22.0",
    "chart.js": "4.5.1",
    "dompurify": "^3.4.15",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "marked": "^18.0.12",
    "zod": "^4.5.4"
  }
}
