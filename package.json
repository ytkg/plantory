{
  "name": "plantory",
  "version": "0.1.0",
  "private": true,
  "description": "Indoor plant monitoring and daily reports.",
  "scripts": {
    "dev": "wrangler dev",
    "predev": "npm run build:assets",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "build:chart": "cp ./node_modules/chart.js/dist/chart.umd.min.js ./public/chart.umd.min.js",
    "build:layout": "node ./scripts/build-layouts.mjs",
    "build:assets": "npm run build:layout && npm run build:css && npm run build:chart",
    "build": "npm run build:assets && npm run check",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.58.0"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "hono": "^4.13.5"
  }
}
